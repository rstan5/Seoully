# Server-only Supabase configuration for Seoully's Next.js DAL.
# These values identify the project and use its publishable (non-privileged) key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only restricted public Room media locator (pending Slice 7 migrations).
# Required for public placed personal imagery. Never use NEXT_PUBLIC_ / EXPO_PUBLIC_.
# The locator does not sign media: signing still uses the authenticated viewer/RLS.
# A legacy SUPABASE_SERVICE_ROLE_KEY can be used instead; do not configure both.
SUPABASE_SECRET_KEY=

# Exact canonical application origin used for Supabase email confirmation redirects.
SITE_URL=http://localhost:3000

# Server-only Ask Seoully / OpenAI (never put these in Expo or EXPO_PUBLIC_*).
# Both are required for Live general conversation. Missing values fail clearly.
OPENAI_API_KEY=
OPENAI_MODEL=
