{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "seoully-domain/*": ["../../src/domain/*"],
      "seoully-public/*": ["../../public/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../src/domain/types.ts",
    "../../src/domain/compatibility.ts",
    "../../src/domain/fixtures/**/*.ts"
  ]
}
