{
  "name": "seoully",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:fixtures": "tsc --project tsconfig.check-fixtures.json && node -r ./scripts/register-build-alias.cjs .tmp/build/scripts/check-fixtures.js",
    "check:slice1": "tsc --project tsconfig.check-slice1.json && node .tmp/build/scripts/check-slice1.js",
    "check:slice2": "tsc --project tsconfig.check-slice2.json && node .tmp/build/scripts/check-slice2.js",
    "check:slice3": "tsc --project tsconfig.check-slice3.json && node -r ./scripts/register-build-alias.cjs .tmp/build/scripts/check-slice3.js",
    "check:slice4": "tsc --project tsconfig.check-slice4.json && node -r ./scripts/register-build-alias.cjs .tmp/build/scripts/check-slice4.js",
    "check:slice5": "tsc --project tsconfig.check-slice5.json && node -r ./scripts/register-build-alias.cjs .tmp/build/scripts/check-slice5.js",
    "check:slice6": "tsc --project tsconfig.check-slice6.json && node -r ./scripts/register-build-alias.cjs .tmp/build/scripts/check-slice6.js",
    "check:slice7": "tsc --project tsconfig.check-slice7.json && node -r ./scripts/register-build-alias.cjs .tmp/build/scripts/check-slice7.js",
    "check:slice7c": "npm run check:slice7",
    "check:slice7d": "tsc --project tsconfig.check-slice7d.json && node -r ./scripts/register-build-alias.cjs .tmp/build/scripts/check-slice7d.js && node scripts/check-room-geometry.cjs && node scripts/check-room-instance-workflows.cjs && npm run check:room-persistence",
    "check:mobile-loading": "node scripts/check-mobile-loading.cjs",
    "check:room-live-sync": "node scripts/check-room-live-sync.cjs",
    "check:room-persistence": "tsc --project tsconfig.check-room-persistence.json && node scripts/check-room-persistence.cjs",
    "check:slice8": "tsc --project tsconfig.check-slice8.json && node -r ./scripts/register-build-alias.cjs .tmp/build/scripts/check-slice8.js && tsc --project tsconfig.check-catalog-contribution.json && node scripts/check-first-home.cjs && node scripts/check-onboarding-experience.cjs && node scripts/check-native-photo-upload.cjs && node scripts/check-first-home-destination.cjs && node scripts/check-slice8-cinematic.cjs && node scripts/check-slice8-qa-repairs.cjs",
    "check:startup": "tsc --project tsconfig.check-startup.json && node .tmp/build/scripts/check-startup.js",
    "check:physical-qa": "tsc --project tsconfig.check-physical-qa.json && node .tmp/build/scripts/check-physical-qa.js",
    "mobile:verify": "node scripts/mobile-verify.cjs",
    "check:catalog-idempotency": "tsc --project tsconfig.check-catalog-contribution.json && node scripts/check-catalog-submission.cjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "motion": "^13.2.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.1.13",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.5",
    "puppeteer-core": "^23.11.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
