{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "outDir": ".tmp/build",
    "skipLibCheck": true,
    "strict": false,
    "esModuleInterop": true
  },
  "include": [
    "scripts/check-slice6.ts",
    "src/domain/ask-context.ts",
    "src/domain/ask-help.ts",
    "src/domain/ask-intent.ts",
    "src/domain/ask-result.ts"
  ]
}
